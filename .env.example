# Configuration PostgreSQL pour FlowTrack
# Copier ce fichier en .env et remplacer les valeurs

# === SUPABASE (Recommandé - Gratuit) ===
# Obtenir cette URL depuis https://supabase.com
DATABASE_URL=postgresql://postgres:your_password@db.supabase.co:5432/postgres

# === OU PostgreSQL Local ===
# DATABASE_URL=postgresql://username:password@localhost:5432/flowtrack

# === Serveur ===
PORT=3005
NODE_ENV=development

# === Optionnel ===
# SUPABASE_KEY=votre_clé_api_supabase
# ENABLE_CORS=true
